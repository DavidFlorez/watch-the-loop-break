# Virtual environments
.venv/
venv/
ENV/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Local caches, scratch checkpoints & temporary outputs
.cache/
.hf_cache/
ckpt_*/
checkpoints/
scratch_ckpt*/
