*.tmp
*.bak
.write.lock
.DS_Store

# Keep assets/ and sweep results tracked in git
!assets/*.png
!assets/*.gif
!assets/*.csv
!assets/*.json
!assets/*.jsonl
!assets/**/*.png
!assets/**/*.csv
!assets/**/*.json
!assets/**/*.jsonl.gz
!assets/**/run.log
